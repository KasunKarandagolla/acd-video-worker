+    @staticmethod
+    def _cinematic_props_from_edit(
+        edit_decisions: dict[str, Any],
+        asset_manifest: dict[str, Any] | None = None,
+    ) -> dict[str, Any]:
+        """Adapt canonical timed cuts to CinematicRenderer mechanics.
+
+        This adapter does not create title copy, scene choices, or other
+        creative content. Every canonical cut remains an already-authored
+        video scene; the adapter only translates field names and sequential
+        timing required by CinematicRendererProps.
+        """
+        scenes: list[dict[str, Any]] = []
+        cursor = 0.0
+        for index, cut in enumerate(edit_decisions.get("cuts") or []):
+            in_seconds = float(cut.get("in_seconds") or 0)
+            out_seconds = float(cut.get("out_seconds") or 0)
+            speed = float(cut.get("speed") or 1.0)
+            duration = max(0.0, (out_seconds - in_seconds) / speed)
+            if duration <= 0:
+                continue
+            scenes.append({
+                "id": str(cut.get("id") or f"cut-{index + 1}"),
+                "kind": "video",
+                "startSeconds": cursor,
+                "durationSeconds": duration,
+                "src": str(cut.get("source") or ""),
+                "trimBeforeSeconds": in_seconds,
+                "trimAfterSeconds": out_seconds,
+                "fadeInFrames": 0 if str(cut.get("transition_in") or "cut") == "cut" else 10,
+                "fadeOutFrames": 0 if str(cut.get("transition_out") or "cut") == "cut" else 10,
+            })
+            cursor += duration
+
+        props: dict[str, Any] = {"scenes": scenes}
+        assets = {str(item.get("id")): item for item in (asset_manifest or {}).get("assets") or []}
+        music = (edit_decisions.get("audio") or {}).get("music") or edit_decisions.get("music") or {}
+        music_asset = assets.get(str(music.get("asset_id") or ""))
+        if music_asset and music_asset.get("path"):
+            props["soundtrack"] = {
+                "src": str(music_asset["path"]),
+                "volume": float(music.get("volume", 1.0)),
+                "fadeInSeconds": float(music.get("fade_in_seconds", 0)),
+                "fadeOutSeconds": float(music.get("fade_out_seconds", 0)),
+            }
+        return props
+
